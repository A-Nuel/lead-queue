# Copy these values into your hosting provider's secret environment variables.
# Do not commit real API keys.
# Automatic order: free-first. Remove providers you don't want to use.
LLM_PROVIDER_ORDER=zai,openrouter,nvidia
ZAI_API_KEY=
ZAI_MODEL=glm-4.7-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OPTIONAL: add these only after checking quotas and billing.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
