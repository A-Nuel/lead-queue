# Copy these values into your hosting provider's secret environment variables.
# Do not commit real API keys.
# Automatic order: free-first. Remove providers you don't want to use.
LLM_PROVIDER_ORDER=deepseek,dashscope,openrouter,zai
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OPTIONAL: add these only after checking quotas and billing.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=
# Select a Qwen model explicitly after checking Alibaba account quotas.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Qwen is provided through Alibaba Model Studio / DashScope, not a separate API provider.
# Use DASHSCOPE_API_KEY and set the model ID from your account's model list.
# DeepSeek API is pay-as-you-go unless your account shows an actual granted balance.
# Set LLM_PROVIDER_ORDER to omit any provider you do not want the app to call.
